{
  "name": "kordis/backend",
  "type": "project",
  "description": "Kordis - Sistema Operacional Hospitalar",
  "require": {
    "php": "^8.2",
    "doctrine/dbal": "^3.8",
    "laravel/framework": "^12.0",
    "laravel/reverb": "^1.0",
    "laravel/sanctum": "^4.0",
    "spatie/laravel-permission": "^6.9",
    "spatie/laravel-query-builder": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.13",
    "phpunit/phpunit": "^11.0",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
